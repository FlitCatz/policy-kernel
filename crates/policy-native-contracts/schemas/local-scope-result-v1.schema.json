{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalScopeResultV1",
  "type": "object",
  "properties": {
    "adapter_version": {
      "$ref": "#/$defs/WorkItemId"
    },
    "digests": {
      "$ref": "#/$defs/ResultDigestsV1"
    },
    "evaluated_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExclusionV1"
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReasonV1"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RequirementResultV1"
      }
    },
    "review": {
      "$ref": "#/$defs/ReviewGate"
    },
    "schema_version": {
      "$ref": "#/$defs/VersionV1"
    },
    "status": {
      "$ref": "#/$defs/ScopeStatus"
    },
    "subject": {
      "$ref": "#/$defs/RunSubjectV1"
    },
    "trust": {
      "$ref": "#/$defs/LocalTrust"
    },
    "verifier_version": {
      "$ref": "#/$defs/WorkItemId"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "subject",
    "requirements",
    "reasons",
    "digests",
    "evaluated_at",
    "verifier_version",
    "adapter_version",
    "trust",
    "review",
    "exclusions"
  ],
  "$defs": {
    "CanonicalDigest": {
      "description": "SHA-256 of the canonical {schema, role, value} envelope.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CanonicalHashKind"
        },
        "role": {
          "$ref": "#/$defs/DigestRole"
        },
        "schema": {
          "$ref": "#/$defs/DigestSchema"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "role",
        "sha256"
      ]
    },
    "CanonicalHashKind": {
      "type": "string",
      "enum": [
        "canonical_sha256"
      ]
    },
    "CommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "DigestRole": {
      "type": "string",
      "enum": [
        "expected_scope",
        "native_run",
        "local_scope_result",
        "source_set",
        "scope_definition",
        "command",
        "configuration",
        "policy",
        "evidence"
      ]
    },
    "DigestSchema": {
      "type": "string",
      "enum": [
        "policy_native_v1"
      ]
    },
    "ExclusionV1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "reason": {
          "$ref": "#/$defs/WorkItemId"
        },
        "scope": {
          "$ref": "#/$defs/WorkItemId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "reason"
      ]
    },
    "ExecutionId": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "LocalTrust": {
      "type": "string",
      "enum": [
        "local_untrusted"
      ]
    },
    "LocationV1": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkItemId"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkItemId"
            },
            {
              "type": "null"
            }
          ]
        },
        "suite_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SensorId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RawByteDigest": {
      "description": "An externally computed SHA-256 of exact file bytes, never typed JSON.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RawHashKind"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ]
    },
    "RawHashKind": {
      "type": "string",
      "enum": [
        "raw_byte_sha256"
      ]
    },
    "ReasonCode": {
      "type": "string",
      "enum": [
        "MISSING_OBSERVATION",
        "SUBJECT_MISMATCH",
        "STALE_OBSERVATION",
        "BINDING_MISMATCH",
        "ARTIFACT_MISMATCH",
        "INVALID_REPORT",
        "UNEXECUTED_MAPPING",
        "SCOPE_UNSATISFIED",
        "INCOMPLETE_RUN"
      ]
    },
    "ReasonV1": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ReasonCode"
        },
        "location": {
          "$ref": "#/$defs/LocationV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "location"
      ]
    },
    "RepositoryId": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "RequirementResultV1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReasonV1"
          }
        },
        "status": {
          "$ref": "#/$defs/ScopeStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reasons"
      ]
    },
    "ResultDigestsV1": {
      "type": "object",
      "properties": {
        "evidence": {
          "description": "Absent when no valid normalized evidence exists.",
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_scope": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "native_run": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "policy": {
          "$ref": "#/$defs/CanonicalDigest"
        }
      },
      "additionalProperties": false,
      "required": [
        "expected_scope",
        "native_run",
        "policy"
      ]
    },
    "ReviewGate": {
      "type": "string",
      "enum": [
        "unmet"
      ]
    },
    "RunSubjectV1": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/ExecutionId"
        },
        "scope_id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "source": {
          "$ref": "#/$defs/SubjectV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "run_id",
        "scope_id"
      ]
    },
    "ScopeStatus": {
      "type": "string",
      "enum": [
        "satisfied",
        "non_pass",
        "error"
      ]
    },
    "SensorId": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SubjectV1": {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "#/$defs/CommitSha"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryId"
        },
        "scope_definition_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "source_inventory_digest": {
          "$ref": "#/$defs/RawByteDigest"
        },
        "source_set_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "head",
        "source_set_digest",
        "source_inventory_digest",
        "scope_definition_digest"
      ]
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "VersionV1": {
      "description": "An unforgeable version value for each independently versioned v1 document.",
      "type": "integer",
      "format": "uint8",
      "maximum": 1,
      "minimum": 1
    },
    "WorkItemId": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    }
  }
}

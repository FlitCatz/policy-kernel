{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeRunV1",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactV1"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ExclusionV1"
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MappingV1"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ObservationV1"
      }
    },
    "schema_version": {
      "$ref": "#/$defs/VersionV1"
    },
    "subject": {
      "$ref": "#/$defs/RunSubjectV1"
    },
    "test_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestObservationV1"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "observations",
    "test_observations",
    "artifacts",
    "mappings",
    "exclusions"
  ],
  "$defs": {
    "ArtifactRefV1": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/RawByteDigest"
        },
        "id": {
          "$ref": "#/$defs/WorkItemId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ]
    },
    "ArtifactRole": {
      "type": "string",
      "enum": [
        "raw_report",
        "command_log",
        "source_inventory",
        "configuration",
        "other"
      ]
    },
    "ArtifactV1": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/RawByteDigest"
        },
        "id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "role",
        "digest"
      ]
    },
    "CanonicalDigest": {
      "description": "SHA-256 of the canonical {schema, role, value} envelope.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CanonicalHashKind"
        },
        "role": {
          "$ref": "#/$defs/DigestRole"
        },
        "schema": {
          "$ref": "#/$defs/DigestSchema"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schema",
        "role",
        "sha256"
      ]
    },
    "CanonicalHashKind": {
      "type": "string",
      "enum": [
        "canonical_sha256"
      ]
    },
    "CommandV1": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "cwd": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd"
      ]
    },
    "CommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "CompletionV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "format": "int32"
            },
            "kind": {
              "type": "string",
              "const": "exited"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "detail": {
              "$ref": "#/$defs/WorkItemId"
            },
            "kind": {
              "type": "string",
              "const": "timed_out"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "detail"
          ]
        },
        {
          "type": "object",
          "properties": {
            "detail": {
              "$ref": "#/$defs/WorkItemId"
            },
            "kind": {
              "type": "string",
              "const": "interrupted"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "detail"
          ]
        },
        {
          "type": "object",
          "properties": {
            "detail": {
              "$ref": "#/$defs/WorkItemId"
            },
            "kind": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "detail"
          ]
        }
      ]
    },
    "DigestRole": {
      "type": "string",
      "enum": [
        "expected_scope",
        "native_run",
        "local_scope_result",
        "source_set",
        "scope_definition",
        "command",
        "configuration",
        "policy",
        "evidence"
      ]
    },
    "DigestSchema": {
      "type": "string",
      "enum": [
        "policy_native_v1"
      ]
    },
    "ExclusionV1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "reason": {
          "$ref": "#/$defs/WorkItemId"
        },
        "scope": {
          "$ref": "#/$defs/WorkItemId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "reason"
      ]
    },
    "ExecutionId": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "MappingV1": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "tests": {
          "$ref": "#/$defs/RequiredSet_TestRefV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "tests"
      ]
    },
    "ObservationV1": {
      "type": "object",
      "properties": {
        "command": {
          "$ref": "#/$defs/CommandV1"
        },
        "completed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "completion": {
          "$ref": "#/$defs/CompletionV1"
        },
        "configuration_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "execution_id": {
          "$ref": "#/$defs/ExecutionId"
        },
        "id": {
          "$ref": "#/$defs/SensorId"
        },
        "observed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "started_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "subject": {
          "$ref": "#/$defs/RunSubjectV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "execution_id",
        "subject",
        "command",
        "configuration_digest",
        "started_at",
        "completed_at",
        "observed_at",
        "completion"
      ]
    },
    "ParserBindingV1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "version": {
          "$ref": "#/$defs/WorkItemId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ]
    },
    "RawByteDigest": {
      "description": "An externally computed SHA-256 of exact file bytes, never typed JSON.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RawHashKind"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "sha256"
      ]
    },
    "RawHashKind": {
      "type": "string",
      "enum": [
        "raw_byte_sha256"
      ]
    },
    "RepositoryId": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "RequiredSet_TestRefV1": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TestRefV1"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "RunSubjectV1": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/ExecutionId"
        },
        "scope_id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "source": {
          "$ref": "#/$defs/SubjectV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "run_id",
        "scope_id"
      ]
    },
    "SensorId": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "SubjectV1": {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "#/$defs/CommitSha"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryId"
        },
        "scope_definition_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "source_inventory_digest": {
          "$ref": "#/$defs/RawByteDigest"
        },
        "source_set_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "head",
        "source_set_digest",
        "source_inventory_digest",
        "scope_definition_digest"
      ]
    },
    "TestCountsV1": {
      "type": "object",
      "properties": {
        "discovered": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "discovered",
        "executed",
        "passed",
        "failed",
        "skipped",
        "retries"
      ]
    },
    "TestObservationV1": {
      "type": "object",
      "properties": {
        "counts": {
          "$ref": "#/$defs/TestCountsV1"
        },
        "observation_id": {
          "$ref": "#/$defs/SensorId"
        },
        "parser": {
          "$ref": "#/$defs/ParserBindingV1"
        },
        "raw_report": {
          "$ref": "#/$defs/ArtifactRefV1"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TestV1"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "observation_id",
        "parser",
        "raw_report",
        "counts",
        "tests"
      ]
    },
    "TestOutcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "not_executed"
      ]
    },
    "TestRefV1": {
      "type": "object",
      "properties": {
        "suite_id": {
          "$ref": "#/$defs/SensorId"
        },
        "test_id": {
          "$ref": "#/$defs/WorkItemId"
        }
      },
      "additionalProperties": false,
      "required": [
        "suite_id",
        "test_id"
      ]
    },
    "TestV1": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "outcome": {
          "$ref": "#/$defs/TestOutcome"
        },
        "raw_identity": {
          "description": "Original producer identity, including absolute paths if emitted by the producer.",
          "$ref": "#/$defs/WorkItemId"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "raw_identity",
        "outcome",
        "attempts"
      ]
    },
    "UtcTimestamp": {
      "type": "string",
      "format": "date-time"
    },
    "VersionV1": {
      "description": "An unforgeable version value for each independently versioned v1 document.",
      "type": "integer",
      "format": "uint8",
      "maximum": 1,
      "minimum": 1
    },
    "WorkItemId": {
      "type": "string",
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    }
  }
}

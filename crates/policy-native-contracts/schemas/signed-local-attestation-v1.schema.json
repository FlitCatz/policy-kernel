{
  "$defs": {
    "CanonicalDigest": {
      "additionalProperties": false,
      "description": "SHA-256 of the canonical {schema, role, value} envelope.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/CanonicalHashKind"
        },
        "role": {
          "$ref": "#/$defs/DigestRole"
        },
        "schema": {
          "$ref": "#/$defs/DigestSchema"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "kind",
        "schema",
        "role",
        "sha256"
      ],
      "type": "object"
    },
    "CanonicalHashKind": {
      "enum": [
        "canonical_sha256"
      ],
      "type": "string"
    },
    "CommitSha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "DigestRole": {
      "enum": [
        "expected_scope",
        "native_run",
        "local_scope_result",
        "source_set",
        "scope_definition",
        "command",
        "configuration",
        "policy",
        "evidence"
      ],
      "type": "string"
    },
    "DigestSchema": {
      "enum": [
        "policy_native_v1"
      ],
      "type": "string"
    },
    "ExecutionId": {
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "type": "string"
    },
    "LocalAttestationDomain": {
      "enum": [
        "policy-kernel/local-runner-attestation/v1"
      ],
      "type": "string"
    },
    "LocalAttestationV1": {
      "additionalProperties": false,
      "properties": {
        "attested_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "base": {
          "$ref": "#/$defs/CommitSha"
        },
        "completed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "domain": {
          "$ref": "#/$defs/LocalAttestationDomain"
        },
        "expected_scope_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "head_tree": {
          "$ref": "#/$defs/CommitSha"
        },
        "native_run_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "observations_digest": {
          "$ref": "#/$defs/LocalDigest"
        },
        "result_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "run_id": {
          "$ref": "#/$defs/ExecutionId"
        },
        "runner": {
          "$ref": "#/$defs/LocalRunnerV1"
        },
        "schema_version": {
          "$ref": "#/$defs/VersionV1"
        },
        "scope_id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "scope_template_digest": {
          "$ref": "#/$defs/LocalDigest"
        },
        "started_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "subject": {
          "$ref": "#/$defs/SubjectV1"
        }
      },
      "required": [
        "schema_version",
        "domain",
        "subject",
        "head_tree",
        "base",
        "run_id",
        "scope_id",
        "expected_scope_digest",
        "scope_template_digest",
        "native_run_digest",
        "observations_digest",
        "result_digest",
        "runner",
        "started_at",
        "completed_at",
        "attested_at"
      ],
      "type": "object"
    },
    "LocalDigest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/CanonicalHashKind"
        },
        "role": {
          "$ref": "#/$defs/LocalDigestRole"
        },
        "schema": {
          "$ref": "#/$defs/DigestSchema"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "kind",
        "schema",
        "role",
        "sha256"
      ],
      "type": "object"
    },
    "LocalDigestRole": {
      "description": "Separate roles preserve every existing scope and ratchet schema byte.",
      "enum": [
        "scope_template",
        "imported_observations",
        "local_attestation"
      ],
      "type": "string"
    },
    "LocalRunnerV1": {
      "additionalProperties": false,
      "properties": {
        "arch": {
          "$ref": "#/$defs/WorkItemId"
        },
        "attestor_version": {
          "$ref": "#/$defs/WorkItemId"
        },
        "os": {
          "$ref": "#/$defs/WorkItemId"
        },
        "runner_id": {
          "$ref": "#/$defs/WorkItemId"
        }
      },
      "required": [
        "runner_id",
        "os",
        "arch",
        "attestor_version"
      ],
      "type": "object"
    },
    "LocalSignatureFormat": {
      "enum": [
        "sshsig"
      ],
      "type": "string"
    },
    "LocalSignatureV1": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "$ref": "#/$defs/LocalSignatureFormat"
        },
        "runner_id": {
          "$ref": "#/$defs/WorkItemId"
        },
        "value": {
          "$ref": "#/$defs/WorkItemId",
          "description": "Opaque nonblank signature. Cryptographic verification belongs to consumers."
        }
      },
      "required": [
        "format",
        "runner_id",
        "value"
      ],
      "type": "object"
    },
    "RawByteDigest": {
      "additionalProperties": false,
      "description": "An externally computed SHA-256 of exact file bytes, never typed JSON.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RawHashKind"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        }
      },
      "required": [
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "RawHashKind": {
      "enum": [
        "raw_byte_sha256"
      ],
      "type": "string"
    },
    "RepositoryId": {
      "pattern": "^[^/]+/[^/]+$",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "SubjectV1": {
      "additionalProperties": false,
      "properties": {
        "head": {
          "$ref": "#/$defs/CommitSha"
        },
        "repository": {
          "$ref": "#/$defs/RepositoryId"
        },
        "scope_definition_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        },
        "source_inventory_digest": {
          "$ref": "#/$defs/RawByteDigest"
        },
        "source_set_digest": {
          "$ref": "#/$defs/CanonicalDigest"
        }
      },
      "required": [
        "repository",
        "head",
        "source_set_digest",
        "source_inventory_digest",
        "scope_definition_digest"
      ],
      "type": "object"
    },
    "UtcTimestamp": {
      "format": "date-time",
      "type": "string"
    },
    "VersionV1": {
      "description": "An unforgeable version value for each independently versioned v1 document.",
      "format": "uint8",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    },
    "WorkItemId": {
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "signature": {
      "$ref": "#/$defs/LocalSignatureV1"
    },
    "statement": {
      "$ref": "#/$defs/LocalAttestationV1"
    }
  },
  "required": [
    "statement",
    "signature"
  ],
  "title": "SignedLocalAttestationV1",
  "type": "object"
}

{
  "$defs": {
    "Risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "SensorCondition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "path_globs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/Risk"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "risks",
        "path_globs"
      ],
      "type": "object"
    },
    "SensorDefinition": {
      "additionalProperties": false,
      "properties": {
        "accepted_exit_codes": {
          "default": [],
          "items": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": -2147483648,
            "type": "integer"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/SensorId"
        },
        "not_applicable_when": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SensorCondition"
          },
          "type": "array"
        },
        "required": {
          "type": "boolean"
        },
        "required_when": {
          "items": {
            "$ref": "#/$defs/SensorCondition"
          },
          "type": "array"
        },
        "result_binding": {
          "$ref": "#/$defs/SensorResultBinding"
        },
        "result_requirement": {
          "$ref": "#/$defs/SensorResultRequirement"
        }
      },
      "required": [
        "id",
        "required",
        "required_when"
      ],
      "type": "object"
    },
    "SensorId": {
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "type": "string"
    },
    "SensorResultBinding": {
      "additionalProperties": false,
      "properties": {
        "configuration_digest": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "parser_version": {
          "type": "string"
        },
        "resolved_command": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "configuration_digest",
        "parser_version",
        "resolved_command"
      ],
      "type": "object"
    },
    "SensorResultRequirement": {
      "enum": [
        "process",
        "test_counts"
      ],
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "TestAdequacyPolicy": {
      "additionalProperties": false,
      "properties": {
        "acceptance_criterion_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "changed_behavior_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "negative_case_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "acceptance_criterion_ids",
        "changed_behavior_ids",
        "negative_case_ids"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "else": {
    "properties": {
      "sensors": {
        "items": {
          "required": [
            "result_requirement"
          ]
        }
      }
    }
  },
  "if": {
    "properties": {
      "schema_version": {
        "const": 1
      }
    }
  },
  "properties": {
    "adequacy": {
      "$ref": "#/$defs/TestAdequacyPolicy"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "sensors": {
      "items": {
        "$ref": "#/$defs/SensorDefinition"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "sensors",
    "adequacy"
  ],
  "then": {
    "properties": {
      "sensors": {
        "items": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "result_requirement"
                ]
              },
              {
                "required": [
                  "result_binding"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "title": "SensorProfile",
  "type": "object"
}

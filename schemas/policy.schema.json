{
  "$defs": {
    "KnowledgeCondition": {
      "additionalProperties": false,
      "properties": {
        "path_globs": {
          "description": "Empty means any path; nonempty entries use the sensor glob semantics.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "risks": {
          "description": "Empty means any risk; risk and path restrictions must both match.",
          "items": {
            "$ref": "#/$defs/Risk"
          },
          "type": "array"
        }
      },
      "required": [
        "risks",
        "path_globs"
      ],
      "type": "object"
    },
    "KnowledgeKind": {
      "enum": [
        "lat_claim",
        "code_graph_index"
      ],
      "type": "string"
    },
    "KnowledgeRequirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/KnowledgeKind"
        },
        "required_when": {
          "description": "Empty means always required. Otherwise, any matching condition applies.",
          "items": {
            "$ref": "#/$defs/KnowledgeCondition"
          },
          "type": "array"
        },
        "source": {
          "not": {
            "pattern": "\u0000"
          },
          "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source",
        "required_when"
      ],
      "type": "object"
    },
    "MergeMethod": {
      "enum": [
        "merge",
        "squash",
        "rebase"
      ],
      "type": "string"
    },
    "Risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type": "string"
    },
    "SensorId": {
      "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]",
      "type": "string"
    },
    "Sha256Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "schema_version": {
        "const": 1
      }
    }
  },
  "properties": {
    "allowed_merge_methods": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MergeMethod"
      },
      "type": "array"
    },
    "authorized_actors": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "authorized_waiver_actors": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "max_evidence_age_seconds": {
      "format": "uint64",
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "policy_digest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "protected_target_branches": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "required_check_name": {
      "type": "string"
    },
    "required_knowledge": {
      "default": null,
      "items": {
        "$ref": "#/$defs/KnowledgeRequirement"
      },
      "type": "array"
    },
    "required_sensor_ids": {
      "items": {
        "$ref": "#/$defs/SensorId"
      },
      "type": "array"
    },
    "schema_version": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "sensor_profile_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Sha256Digest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "policy_digest",
    "required_check_name",
    "max_evidence_age_seconds",
    "authorized_actors",
    "required_sensor_ids"
  ],
  "then": {
    "not": {
      "required": [
        "required_knowledge"
      ]
    }
  },
  "title": "PolicySnapshot",
  "type": "object"
}
